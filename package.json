{
	"name": "n8n-nodes-sarj",
	"version": "0.1.0",
	"description": "Read Sarj AI call history, transcripts and analysis with a scoped API key.",
	"license": "MIT",
	"homepage": "https://github.com/sarj-ai/n8n-nodes-sarj#readme",
	"keywords": [
		"n8n-community-node-package",
		"sarj",
		"call-analytics",
		"transcripts",
		"mcp"
	],
	"author": {
		"name": "Sarj AI",
		"email": "engineering@sarj.ai"
	},
	"repository": {
		"type": "git",
		"url": "https://github.com/sarj-ai/n8n-nodes-sarj.git"
	},
	"scripts": {
		"build": "n8n-node build",
		"build:watch": "tsc --watch",
		"dev": "n8n-node dev",
		"lint": "n8n-node lint",
		"lint:fix": "n8n-node lint --fix",
		"release": "n8n-node release",
		"prepublishOnly": "n8n-node prerelease",
		"test": "npm run build && node --test test/*.test.cjs",
		"check": "npm run lint && npm test",
		"check:package": "node scripts/check-package.cjs"
	},
	"files": [
		"dist/nodes",
		"dist/credentials",
		"examples",
		"CHANGELOG.md"
	],
	"n8n": {
		"n8nNodesApiVersion": 1,
		"strict": true,
		"credentials": [
			"dist/credentials/SarjApi.credentials.js"
		],
		"nodes": [
			"dist/nodes/Sarj/Sarj.node.js"
		]
	},
	"devDependencies": {
		"@n8n/node-cli": "0.58.7",
		"eslint": "9.39.4",
		"prettier": "3.8.3",
		"release-it": "20.2.0",
		"typescript": "5.9.3",
		"n8n-workflow": "2.49.5",
		"@types/node": "22.19.3"
	},
	"peerDependencies": {
		"n8n-workflow": "*"
	},
	"bugs": {
		"url": "https://github.com/sarj-ai/n8n-nodes-sarj/issues"
	},
	"engines": {
		"node": ">=24.0.0"
	},
	"publishConfig": {
		"access": "public"
	}
}
